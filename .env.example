# ---- Gnani API Platform (required for the real demo) ----
GNANI_API_KEY=
VOICE_MODE=gnani                 # gnani | mock (mock = typed text only, nothing spoken, clearly labelled in UI)

# Prisma v3.0 streaming STT
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGES=hi-IN,kn-IN,en-IN       # tried first; if Prisma rejects a list, the app falls back to indic-auto automatically
GNANI_STT_FORMAT=transcribe      # Hindi in Devanagari, English words in Latin, numbers as digits
GNANI_VAD_THRESHOLD=0.6          # raise (0.7-0.8) if street noise triggers false speech
GNANI_MIN_SILENCE_MS=400         # hands-free turn end; push-to-talk uses commit instead

# Timbre v3.0 streaming TTS
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani          # any v3.0 voice: Shivani, Chetana, Kalpana, Avinash, Devansh, ...
GNANI_TTS_SPEED=1.05
TTS_NUMBERS_AS_WORDS=1           # speak "तीन सौ चालीस रुपये" instead of relying on "₹340" normalisation

# ---- Optional LLM fallback (OpenAI-compatible; only for utterances the rule parser can't read) ----
LLM_BASE_URL=                    # e.g. https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=                       # e.g. llama-3.3-70b-versatile

# ---- Storage ----
DB_PATH=data/khata.db
LEDGER_KEY=                      # Fernet key; blank = auto-created in data/.ledger_key (gitignored)
SEED_DEMO=1
CONFIRM_MODE=low                 # low = ask only when unsure | always = confirm every write
GREETING_LANGUAGE=hi
HANDSFREE_WAKE=1                 # hands-free: only sentences starting "Chotu, ..." are commands
