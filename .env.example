# ---- Gnani API Platform (required for the real demo) ----
GNANI_API_KEY=
VOICE_MODE=gnani                 # gnani | mock (mock = typed text only, nothing spoken, clearly labelled in UI)

# Prisma v3.0 streaming STT
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGES=hi-IN,kn-IN,en-IN       # tried first; if Prisma rejects a list, the app falls back to indic-auto automatically
GNANI_STT_FORMAT=transcribe      # Hindi in Devanagari, English words in Latin, numbers as digits
GNANI_VAD_THRESHOLD=0.6          # raise (0.7-0.8) if street noise triggers false speech
GNANI_MIN_SILENCE_MS=400         # hands-free turn end; push-to-talk uses commit instead

# Timbre v3.0 streaming TTS
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani          # any v3.0 voice: Shivani, Chetana, Kalpana, Avinash, Devansh, ...
GNANI_TTS_SPEED=1.05
TTS_NUMBERS_AS_WORDS=1           # speak "तीन सौ चालीस रुपये" instead of relying on "₹340" normalisation

# ---- "Hey Chotu" wake word (Picovoice Porcupine, runs on the phone) ----
# 1) console.picovoice.ai -> copy AccessKey  2) Porcupine -> train "Hey Chotu" -> download for Web (WASM)
# 3) put the .ppn file in web/wake/   (blank key = wake word off, hold-to-talk still works)
PICOVOICE_ACCESS_KEY=
WAKE_SENSITIVITY=0.6             # 0..1: higher wakes more easily but also on similar words
GNANI_VAD_THRESHOLD=0.75         # 0..1: higher ignores more background chatter
CLOSING_TIME=21:00               # daily spoken summary (also changeable by voice / in Hisaab)

# ---- Understanding (LLM). Any OpenAI-compatible API. Blank = rule parser only. ----
# Groq (fast, free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-20b  (or openai/gpt-oss-120b: smarter, a bit slower)
# xAI Grok:                 LLM_BASE_URL=https://api.x.ai/v1              LLM_MODEL=grok-3-mini   (check console.x.ai for current names)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
NLU_MODE=llm                     # llm = LLM reads every sentence, rules are the fallback | rules = rules first
LLM_TIMEOUT_S=3

# ---- Storage ----
DB_PATH=data/khata.db           # local SQLite file (kept across restarts)
DATABASE_URL=                    # Postgres URL; set on Render automatically by render.yaml
LEDGER_KEY=                      # Fernet key; blank = auto-created in data/.ledger_key (gitignored)
SEED_DEMO=1
CONFIRM_MODE=low                 # low = ask only when unsure | always = confirm every write
GREETING_LANGUAGE=hi
HANDSFREE_WAKE=1                 # hands-free: only sentences starting "Chotu, ..." are commands
